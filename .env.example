# --- MiniMax (text LLM, OpenAI-compatible) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TEXT_MODEL=MiniMax-Text-01

# --- Optional extra LLM providers (only needed if a skill routes to them) ---
# Each agent's provider/model is set in app/llm/skills.py; default is MiniMax.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- AtlasCloud (image + video gateway) ---
ATLASCLOUD_API_KEY=
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1
ATLAS_IMAGE_MODEL=baidu/ERNIE-Image-Turbo/text-to-image
ATLAS_VIDEO_MODEL=kwaivgi/kling-video-o3-pro/reference-to-video

# Default video aspect ratio (16:9 | 9:16 | 1:1)
DEFAULT_ASPECT_RATIO=9:16

# --- Storage / DB ---
STORAGE_ROOT=./storage
DATABASE_URL=sqlite:///./db.sqlite

# --- LLM tuning ---
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.4

# --- Render polling ---
POLL_INTERVAL_S=5
POLL_TIMEOUT_S=600
MAX_CONCURRENT_POLLS=3

# --- Worker ---
WORKER_CONCURRENCY=2
