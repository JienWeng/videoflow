# --- MiniMax (text LLM, OpenAI-compatible) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TEXT_MODEL=MiniMax-Text-01

# --- Optional extra LLM providers (only needed if a skill routes to them) ---
# Each agent can be overridden in Settings; story agents default to OpenCode Go.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Additional optional endpoints. Named UI connections inherit their preset's
# environment credentials until an independent key is saved in the UI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_VIDEO_MODEL=google/veo-3.1-lite
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- AtlasCloud (image + video gateway) ---
ATLASCLOUD_API_KEY=
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/api/v1
ATLAS_IMAGE_MODEL=openai/gpt-image-2/text-to-image
ATLAS_IMAGE_QUALITY=low
ATLAS_VIDEO_MODEL=minimax/h3-developer/text-to-video
ATLAS_VIDEO_RESOLUTION=480P
ATLAS_VIDEO_PROMPT_EXPANSION=false

# Default video aspect ratio (16:9 | 9:16 | 1:1)
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_IMAGE_PROVIDER=atlascloud
DEFAULT_VIDEO_PROVIDER=atlascloud

# --- Storage / DB ---
STORAGE_ROOT=./storage
DATABASE_URL=sqlite:///./db.sqlite

# --- LLM tuning ---
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.4

# --- Render polling ---
POLL_INTERVAL_S=5
POLL_TIMEOUT_S=600
MAX_CONCURRENT_POLLS=3

# --- Worker ---
WORKER_CONCURRENCY=2
